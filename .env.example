# A-01 server-side Gemini Developer API key. Never copy into capture/ or commit .env.local.
# Confirm the API tier/billing project before sending supplier frames (docs/decisions.md D-055).
GEMINI_API_KEY=
# Optional local service data directory; this may contain photographs and must stay out of git.
PROOFSHAPE_DATA_DIR=proofshape-data/sessions
# A-04 shape completion. Only the literal 0 turns the stage off. With no runner set (the default,
# and the only option on the M2 Max: LaS-Comp is CUDA-only) the stage prepares its inputs and
# records 'unavailable' without warning the supplier (D-058). Read D-058 before setting a runner.
# PROOFSHAPE_COMPLETION=0
# PROOFSHAPE_COMPLETION_RUNNER=/path/to/lascomp-venv/bin/python /path/to/scripts/lascomp_runner.py
