# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- GPU pod (values are per-deployment; never commit real ones) ---
RUNPOD_POD_ID=pod-xxxxxxxxxxxx
RUNPOD_PROXY_HOST=xxxxxxxxxxxx-8000.proxy.runpod.net
RUNPOD_VOLUME_ID=vol-xxxxxxxxxxxx
RUNPOD_API_KEY=

# --- Vision-language / language model (§6.5, §7.4) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- Service ---
PROOFSHAPE_ENV=development
PROOFSHAPE_PUBLIC_BASE_URL=https://localhost:8000

# --- Example identifiers used in docs and tests ---
EXAMPLE_PO_CODE=PO-EXAMPLE-0001
